{
  "name": "@tanstack/solid-template",
  "version": "0.0.0",
  "description": "Solid adapter for TanStack Template",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/template.git",
    "directory": "packages/solid-template"
  },
  "homepage": "https://tanstack.com/template",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "solid",
    "tanstack",
    "template"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint": "eslint ./src",
    "test:eslint": "eslint ./src",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "tsdown",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tanstack/solid-store": "^0.11.1",
    "@tanstack/template": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "solid-js": "^1.9.15",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "solid-js": ">=1.7.0"
  }
}
